NODE_ENV=test
AI_SERVICE_PORT=3004

# LLM 프로바이더 (claude | openai | gemini | groq | ollama)
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Ollama (로컬)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=bge-m3

# OpenAI / Anthropic (클라우드 전환 시)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# MongoDB (벡터 저장소)
MONGODB_VECTOR_URI=mongodb://user:password@localhost:27017
MONGODB_DB_NAME=ai_service

# Redis (잡 메타데이터 / Redis Streams 결과 릴레이)
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379

# Kafka (Gateway로부터의 비동기 잡 큐)
KAFKA_BROKERS=localhost:9092
