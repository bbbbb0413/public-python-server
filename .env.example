NODE_ENV=test
AI_SERVICE_PORT=3004

# LLM 프로바이더 (claude | openai | gemini | groq | ollama)
LLM_PROVIDER=ollama
# 임베딩 프로바이더 (ollama | gemini | openai) — groq는 임베딩 모델을 제공하지 않아 미구현
EMBEDDING_PROVIDER=ollama

# Ollama (로컬)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=bge-m3

# OpenAI / Anthropic (클라우드 전환 시)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Gemini (LLM_PROVIDER=gemini 또는 EMBEDDING_PROVIDER=gemini 일 때 필수)
# https://aistudio.google.com/apikey 에서 무료로 발급
# GOOGLE_API_KEY=
# text-embedding-004는 2026-01-14 폐기됨. gemini-embedding-001 사용 (GA, 무료 티어)
# 네이티브 3072차원, MRL로 768/1536/3072 중 선택 가능(공식 권장값). 바꾸면 EMBEDDING_DIMENSION도 같이 맞출 것
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# MongoDB (벡터 저장소)
MONGODB_VECTOR_URI=mongodb://user:password@localhost:27017
MONGODB_DB_NAME=ai_service

# Redis (잡 메타데이터 / Redis Streams 결과 릴레이)
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379

# Kafka (Gateway로부터의 비동기 잡 큐)
KAFKA_BROKERS=localhost:9092
